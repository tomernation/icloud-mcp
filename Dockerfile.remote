FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /icloud-mcp ./cmd/icloud-mcp
FROM python:3.13-slim-bookworm AS reminders-runtime
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates tzdata && rm -rf /var/lib/apt/lists/*
COPY scripts/reminders-probe-requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/reminders && /opt/reminders/bin/pip install --no-cache-dir -r /tmp/requirements.txt && apt-get purge -y git && apt-get autoremove -y && rm /tmp/requirements.txt
COPY scripts/reminders_worker.py /opt/reminders_worker.py
COPY --from=build /icloud-mcp /icloud-mcp
RUN useradd --uid 65532 --create-home nonroot
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/icloud-mcp"]
CMD ["-http", ":8443"]
