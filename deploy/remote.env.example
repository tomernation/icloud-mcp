# No real values. Inject secret files at runtime; never bake into images.
ICLOUD_EMAIL=file:///run/secrets/icloud-email
ICLOUD_PASSWORD=file:///run/secrets/icloud-app-password
ICLOUD_MCP_READ_ONLY=true
ICLOUD_MCP_ENABLE_CONTACTS=false
ICLOUD_MCP_ENABLE_MAIL=false
ICLOUD_MCP_DEFAULT_TZ=America/Los_Angeles
MCP_RESOURCE=https://mcp.example.com/mcp
MCP_ISSUER=https://identity.example.com
MCP_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
MCP_OWNER_SUB=REPLACE_WITH_IMMUTABLE_OWNER_SUBJECT
MCP_INTROSPECTION_CLIENT_ID=REPLACE_WITH_RESOURCE_SERVER_CLIENT_ID
MCP_INTROSPECTION_SECRET_FILE=/run/secrets/oauth-introspection-secret
MCP_TLS_CERT=/run/secrets/tls-chain.pem
MCP_TLS_KEY=/run/secrets/tls-key.pem
